# ---- Supabase (client, public) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public origin of the deployed app (used for OAuth redirects, sitemap, canonical)
VITE_PUBLIC_APP_ORIGIN=https://your-domain.co.il

# ---- Supabase (server only) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI (OpenAI-compatible; default = Google Gemini) ----
AI_API_KEY=
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.5-flash

# ---- Site scan (onboarding) ----
FIRECRAWL_API_KEY=

# ---- Make.com (OTP + scan webhooks) ----
MAKE_OTP_WEBHOOK_URL=
MAKE_OUTBOUND_TOKEN=
MAKE_INBOUND_SECRET=
# Comma-separated phones that skip real OTP (testing)
TEST_PHONES=

# ---- Grow / Meshulam payments ----
MESHULAM_USER_ID=
MESHULAM_PAGE_CODE=
MESHULAM_API_KEY=

# ---- Stripe (legacy, optional) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
